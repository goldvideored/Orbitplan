static func t(s: String) -> String:
	if lang == "ru" or not DATA.has(s):
		return s
	var i := -1
	for j in LANGS.size():
		if LANGS[j][0] == lang:
			i = j - 1
			break
	if i < 0:
		return s
	var row: Array = DATA[s]
	return String(row[i]) if i < row.size() else s


static func lang_name(code: String) -> String:
	for l in LANGS:
		if l[0] == code:
			return String(l[1])
	return code
